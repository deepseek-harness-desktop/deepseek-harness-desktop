{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.0",
  "identifier": "ai.deepseek.harness",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "DeepSeek Harness", "width": 1280, "height": 840, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/dsh-desktop-runtime"],
    "icon": [],
    "targets": ["dmg", "nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop application",
    "longDescription": "A desktop shell for the DeepSeek Harness agent runtime."
  }
}
